# ==========================================
# GOOGLE GEMINI API CONFIGURATION
# ==========================================
# Optional: used for AI-powered name, trait, portrait, and backstory generation.
# Get your API key from: https://aistudio.google.com/app/apikey

# Preferred (Vite convention)
VITE_GEMINI_API_KEY=

# Supported for compatibility with older setups
GEMINI_API_KEY=

# ==========================================
# OPENROUTER API CONFIGURATION
# ==========================================
# Optional: used for provider-aware AI generation and OpenRouter model refreshes.
# Get your API key from: https://openrouter.ai/

VITE_OPENROUTER_API_KEY=

# Supported for compatibility with older setups
OPENROUTER_API_KEY=

# If you do not set a key, the app will still work; AI features will be disabled.
